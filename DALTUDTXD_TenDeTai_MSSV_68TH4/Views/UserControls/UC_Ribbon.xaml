<UserControl x:Class="DALTUDTXD_TenDeTai_MSSV_68TH4.Views.UserControls.UC_Ribbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_TenDeTai_MSSV_68TH4.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    <Grid>
        <Ribbon Grid.Row="0" SelectedIndex="0" Background="#FFDDE7F4">
            <RibbonTab Header="Dữ liệu" >
                <RibbonGroup Header="Etabs API">
                    <RibbonButton x:Name="rbt_KetNoiEtabs" Label="Kết nối Etabs"
                         Click="rbt_KetNoiEtabs_Click"    LargeImageSource="/Assets/Icons/AddLink.png"/>

                    
                    <RibbonCheckBox Label="Lấy dữ liệu tự động"/>
                    <RibbonComboBox Label="Chọn loại kết cấu"
                               SmallImageSource="/Assets/Icons/Download from the Cloud.png">
                        <RibbonGallery>
                            <RibbonGalleryCategory>
                                <RibbonGalleryItem Content="Kết cấu thép"/>
                                <RibbonGalleryItem Content="Kết cấu bê tông"/>
                                <RibbonGalleryItem Content="Kết cấu gỗ"/>
                            </RibbonGalleryCategory>
                        </RibbonGallery>
                    </RibbonComboBox>
                </RibbonGroup>

            </RibbonTab>


            <RibbonTab Header="Mặt bằng" >
                <RibbonGroup Header="Mặt bằng">
                    <RibbonButton x:Name="rbt_2Dplan" Label="Mặt bằng 2D" Click="rbt_2Dplan_Click"
                      SmallImageSource="/Assets/Icons/Bookmark.png"/>
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Thiết kế" >

            </RibbonTab>

        </Ribbon>
    </Grid>
</UserControl>
